# Copy this file to .env and fill in your values. .env is git-ignored.
# The real process environment always overrides .env.

# Where your dump1090 checkout lives. This project only READS from here
# (public_html/data/aircraft.json, public_html/db, geojson, ol).
DUMP1090_DIR=~/dump1090-web

# Your ADS-B receiver position. Match the --lat/--lon you pass to dump1090.
# Leave at 0.0 and the dashboards still run, but distance/bearing and the
# map centre will be wrong.
RECEIVER_LAT=0.0
RECEIVER_LON=0.0

# --- Optional overrides -------------------------------------------------
# Where this project WRITES the flight log + database (default: ./data).
# DATA_DIR=./data
# Roll flight_log.csv to a timestamped part at this size in MB (0 = never).
# MAX_CSV_MB=100
# Max observation rows one /api/data response loads from the DB (newest first).
# MAX_ROWS=500000
# HTTPS server bind + port.
# HOST=0.0.0.0
# PORT=1978
# Logger poll interval in seconds.
# POLL_INTERVAL_SECONDS=5
# TLS cert directory (default: ./certs).
# CERT_DIR=./certs
